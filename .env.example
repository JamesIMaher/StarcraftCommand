# Copy this file to .env (which is gitignored -- never commit the real key)
# and fill in a real key from https://console.anthropic.com/settings/keys.
# interactive_play.py loads .env automatically via python-dotenv.
ANTHROPIC_API_KEY=sk-ant-...

# Only for --kamiwaza-url (the command console hosted on Kamiwaza, with the
# platform's own LLM interpreting commands -- ANTHROPIC_API_KEY isn't needed
# then). A personal access token from your Kamiwaza instance: create one in
# the UI, or POST /api/auth/pats. Set KAMIWAZA_VERIFY_SSL=false if the
# instance uses a self-signed certificate.
KAMIWAZA_API_KEY=
KAMIWAZA_VERIFY_SSL=true
